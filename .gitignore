# ── Environment & Secrets ────────────────────────────────────────────
.env
*.env
!.env.example

# ── Python & Django ──────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
*.log
staticfiles/
media/
local_settings.py
htmlcov/
.coverage
.pytest_cache/

# ── Flutter & Dart ───────────────────────────────────────────────────
**/doc/api/
.dart_tool/
**/frontend/.dart_tool/
**/build/
**/frontend/build/
.flutter-plugins
.flutter-plugins-dependencies
**/frontend/.flutter-plugins*
.packages
**/frontend/.packages
*.apk
*.aab
*.app
*.ipa

# Android build & local artifacts
**/android/**/gradle-wrapper.jar
**/android/.gradle/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java

# iOS / macOS build & CocoaPods
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Pods/
**/ios/.symlinks/
**/ios/profile
**/ios/release
**/ios/**/GeneratedPluginRegistrant.h
**/ios/**/GeneratedPluginRegistrant.m
**/ios/**/GeneratedPluginRegistrant.swift

# Windows / Linux desktop ephemeral
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/

